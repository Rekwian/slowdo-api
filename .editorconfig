root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[config/**.yaml]
indent_size = 4

[Caddyfile]
indent_style = tab

[Makefile]
indent_style = tab

[{**.php,config.*.yaml}]
indent_size = 4

[*.html.twig]
indent_size = 4

[*.md]
indent_size = 4
trim_trailing_whitespace = false
